{
  "name": "zone-rouge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A text-based survival roguelike for the browser. Lorraine and the Low Countries, January 1984.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run validate && npm run body && npm run hold && npm run smoke -- 300",
    "playtest": "vite build --mode single && node scripts/playtest-page.mjs",
    "body": "tsx scripts/body-check.ts",
    "hold": "tsx scripts/hold-check.ts"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "dependencies": {
    "yaml": "2.5.1",
    "zod": "3.23.8"
  }
}
